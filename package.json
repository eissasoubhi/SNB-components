{
  "name": "snb-components",
  "version": "3.0.0-rc.0",
  "description": "Small shared runtime primitives for Summernote Bricks plugins.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.umd.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:js": "vite build --config vite.config.ts",
    "build:types": "tsc -p tsconfig.build.json && node scripts/fix-declaration-specifiers.mjs",
    "build": "npm run build:js && npm run build:types",
    "test": "vitest run --config vitest.config.ts",
    "pack:check": "node scripts/validate-package.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run pack:check"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.32",
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/eissasoubhi/SNB-components.git"
  },
  "bugs": { "url": "https://github.com/eissasoubhi/SNB-components/issues" },
  "homepage": "https://github.com/eissasoubhi/SNB-components#readme",
  "keywords": ["summernote", "summernote-plugin", "wysiwyg", "editor", "bricks"]
}
