{
  "name": "snb-components",
  "version": "3.0.0-rc.0",
  "description": "Small shared runtime primitives for Summernote Bricks v3 plugins",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/eissasoubhi/SNB-components.git"
  },
  "bugs": {
    "url": "https://github.com/eissasoubhi/SNB-components/issues"
  },
  "homepage": "https://github.com/eissasoubhi/SNB-components#readme",
  "keywords": [
    "summernote",
    "summernote-plugin",
    "wysiwyg",
    "editor",
    "bricks"
  ]
}
